# ============================================================
# ACADGRAPH ENVIRONMENT CONFIGURATION
# ============================================================

# Neo4j Connection Details
# For Neo4j Aura (Cloud): neo4j+s://<dbid>.databases.neo4j.io
# For Local Neo4j Desktop / Docker: neo4j://localhost:7687 or bolt://localhost:7687
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# JWT Authentication & RBAC
JWT_SECRET_KEY=acadgraph_super_secret_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models Configuration
SCIBERT_MODEL_PATH=model/scibert_ner_model
RELATION_MODEL_PATH=model/relation_model.pkl
RELATION_VECTORIZER_PATH=model/relation_vectorizer.pkl
